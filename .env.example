# Credenciais do MinIO (emulando as credenciais de acesso ao S3)
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Bucket que funciona como raiz do lakehouse (camadas bronze/silver/gold ficam dentro)
LAKE_BUCKET=lakehouse

# Caminho do CSV bruto DENTRO do container (a pasta ./data é montada em /app/data).
# Descomente e ajuste para reprocessar outra competência/UF — o SQL não muda.
# CSV_PATH=/app/data/pda-024-icb-SP-2025_08.csv
